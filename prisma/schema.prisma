generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(caixa)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            Int        @id @default(autoincrement())
  name          String
  barcode       String     @unique
  price         Decimal    @db.Decimal(12, 2)
  costPrice     Decimal    @default(0) @db.Decimal(12, 2)
  stockQuantity Decimal    @db.Decimal(14, 3)
  unit          String     @default("UN") @db.VarChar(10)
  lowStockThreshold Decimal @default(0) @db.Decimal(14, 3)
  categoryId    Int?
  category      Category?  @relation(fields: [categoryId], references: [id])
  createdAt     DateTime   @default(now())
  archivedAt    DateTime?
  saleItems     SaleItem[]
}

model Sale {
  id             Int           @id @default(autoincrement())
  idempotencyKey String        @unique @db.Uuid
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  cashRegisterId Int
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  creditPaidAt   DateTime?
  creditPaidAmount Decimal @default(0) @db.Decimal(12, 2)
  cancelledAt    DateTime?
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  sales     Sale[]
  creditPayments CreditPayment[]
}

model CreditPayment {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
}

model CashRegister {
  id            Int            @id @default(autoincrement())
  openedAt      DateTime
  closedAt      DateTime?
  initialAmount Decimal        @db.Decimal(12, 2)
  closingAmount Decimal?       @db.Decimal(12, 2)
  status        CashStatus     @default(open)
  movements     CashMovement[]
  sales         Sale[]
}

model CashMovement {
  id             Int              @id @default(autoincrement())
  cashRegisterId Int
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  createdAt      DateTime         @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())
}

enum UserRole {
  admin
  gerente
  caixa
  estoque
}

enum PaymentMethod {
  dinheiro
  cartao_credito
  cartao_debito
  pix
  fiado
}

enum CashStatus {
  open
  closed
}

enum CashMovementType {
  cash_in  @map("in")
  cash_out @map("out")
}
